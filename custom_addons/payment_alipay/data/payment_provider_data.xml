<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_alipay" model="payment.provider">
        <field name="name">Alipay</field>
        <field name="code">alipay</field>
        <field name="state">disabled</field>
        <field name="redirect_form_view_id" ref="payment_alipay.redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_alipay')])]"/>
        <field name="pending_msg">Complete payment in Alipay. The order is confirmed only after signed payment confirmation.</field>
        <field name="done_msg">Alipay payment completed.</field>
        <field name="cancel_msg">Alipay payment cancelled.</field>
    </record>
</odoo>
