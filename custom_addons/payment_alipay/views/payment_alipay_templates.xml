<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

    <template id="alipay_state_header" inherit_id="payment.state_header">
        <xpath expr="//div[@name='o_payment_status_alert']" position="before">
            <t t-set="alipay_is_english" t-value="bool(request.lang and (request.lang.code or '').lower().startswith('en'))"/>
            <t t-if="tx.provider_id.sudo().code == 'alipay'">
                <t t-if="tx.state == 'pending'" t-set="status_message">
                    <p t-out="'Waiting for signed confirmation from Alipay.' if alipay_is_english else '正在等待支付宝的签名支付确认。'"/>
                </t>
                <t t-elif="tx.state == 'done'" t-set="status_message">
                    <p t-out="'Alipay payment completed.' if alipay_is_english else '支付宝支付已完成。'"/>
                </t>
                <t t-elif="tx.state == 'cancel'" t-set="status_message">
                    <p t-out="'Alipay payment cancelled.' if alipay_is_english else '支付宝支付已取消。'"/>
                </t>
            </t>
            <h1 t-if="tx.provider_id.sudo().code == 'alipay' and tx.state == 'pending'" class="mb-3"
                t-out="'Pay with Alipay' if alipay_is_english else '请使用支付宝付款'"/>
        </xpath>
        <xpath expr="//div[@name='o_payment_status_alert']" position="inside">
            <t t-if="tx.provider_id.sudo().code == 'alipay' and tx.state == 'pending' and tx.alipay_qr_code">
                <div class="card order-1 order-md-3 flex-shrink-0">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <t t-if="tx.provider_id.sudo().alipay_simulation_mode">
                            <p class="text-center mb-2"
                               t-out="'Alipay simulation mode: no real charge will be made.' if alipay_is_english else '当前为支付宝模拟沙箱，不会产生真实扣款。'"/>
                            <form t-att-action="'/payment/alipay/simulate_success'" method="post" class="mt-2">
                                <input type="hidden" name="reference" t-att-value="tx.reference"/>
                                <input type="hidden" name="simulation_token" t-att-value="tx.alipay_simulation_token"/>
                                <button type="submit" class="btn btn-primary"
                                        t-out="'Simulate successful payment' if alipay_is_english else '模拟支付成功'"/>
                            </form>
                        </t>
                        <t t-else="">
                            <t t-set="alipay_qr_data_uri" t-value="tx._get_alipay_qr_data_uri()"/>
                            <img t-if="alipay_qr_data_uri" class="mb-2 border rounded" t-att-src="alipay_qr_data_uri" alt="Alipay QR code"/>
                            <small t-if="alipay_qr_data_uri" class="text-center"
                                   t-out="'Scan with Alipay to complete payment' if alipay_is_english else '打开支付宝扫一扫完成付款'"/>
                            <div t-else="" class="alert alert-warning mb-0" role="alert"
                                 t-out="'The QR code cannot be displayed. No charge has been made.' if alipay_is_english else '二维码暂时无法显示，订单尚未扣款。'"/>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="alipay_bilingual_payment_method_name" inherit_id="payment.method_form">
        <xpath expr="//label[@t-out='pm_sudo.name']" position="attributes">
            <attribute name="t-out">('Alipay' if (request.lang and (request.lang.code or '').lower().startswith('en')) else '支付宝') if pm_sudo.code == 'alipay' else pm_sudo.name</attribute>
        </xpath>
    </template>
</odoo>
