<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shop_api" model="ir.module.category">
        <field name="name">Shop APIs</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_shop_api" model="res.groups.privilege">
        <field name="name">Shop APIs</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="shop_api.module_category_shop_api"/>
    </record>

    <record id="group_shop_api_auditor" model="res.groups">
        <field name="name">Shop API 审计员</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="shop_api.privilege_shop_api"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_shop_api_operator" model="res.groups">
        <field name="name">Shop API 操作员</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="shop_api.privilege_shop_api"/>
        <field name="implied_ids" eval="[Command.link(ref('shop_api.group_shop_api_auditor'))]"/>
    </record>

    <record id="group_shop_api_admin" model="res.groups">
        <field name="name">Shop API 管理员</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="shop_api.privilege_shop_api"/>
        <field name="implied_ids" eval="[Command.link(ref('shop_api.group_shop_api_operator'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="group_shop_api_integration" model="res.groups">
        <field name="name">Shop API 集成客户端</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="rule_shop_api_configuration_company" model="ir.rule">
        <field name="name">Shop API 配置公司隔离</field>
        <field name="model_id" ref="model_shop_api_configuration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('shop_api.group_shop_api_auditor'))]"/>
    </record>

    <record id="rule_shop_api_reservation_company" model="ir.rule">
        <field name="name">Shop API 库存预留公司隔离</field>
        <field name="model_id" ref="model_shop_api_reservation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('shop_api.group_shop_api_auditor'))]"/>
    </record>
</odoo>
