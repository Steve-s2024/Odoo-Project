<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_api_reservation_list" model="ir.ui.view">
        <field name="name">shop.api.reservation.list</field><field name="model">shop.api.reservation</field>
        <field name="arch" type="xml"><list string="库存预留" create="0" delete="0"><field name="name" string="预留编号"/><field name="external_id" string="商城预留编号"/><field name="client_id" string="客户端"/><field name="partner_id" string="客户" optional="hide"/><field name="expires_at" string="失效时间"/><field name="confirmed_order_id" string="销售订单"/><field name="state" string="状态" decoration-success="state == 'confirmed'" decoration-warning="state == 'active'" decoration-muted="state in ('released','expired','cancelled')"/></list></field>
    </record>
    <record id="view_shop_api_reservation_form" model="ir.ui.view">
        <field name="name">shop.api.reservation.form</field><field name="model">shop.api.reservation</field>
        <field name="arch" type="xml"><form string="库存预留" create="0" delete="0"><header><button name="action_extend" type="object" string="延长预留" class="btn-primary" invisible="state != 'active'"/><button name="action_release" type="object" string="释放预留" invisible="state != 'active'" confirm="释放后库存将立即重新可售。确定继续吗？"/><field name="state" widget="statusbar" statusbar_visible="active,confirmed,released,expired,cancelled"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div><group><group><field name="external_id" readonly="1"/><field name="client_id" readonly="1"/><field name="company_id" readonly="1" groups="base.group_multi_company"/><field name="website_id" readonly="1"/></group><group><field name="partner_id" readonly="1"/><field name="expires_at" readonly="1"/><field name="confirmed_order_id" readonly="1"/></group></group><notebook><page string="预留商品"><field name="line_ids" readonly="1"><list create="0" delete="0"><field name="product_id"/><field name="quantity"/><field name="product_uom_id"/><field name="source_location_id"/><field name="available_quantity_snapshot" string="预留时可用数量"/></list></field></page><page string="备注"><field name="notes"/></page></notebook></sheet></form></field>
    </record>
    <record id="view_shop_api_reservation_search" model="ir.ui.view"><field name="name">shop.api.reservation.search</field><field name="model">shop.api.reservation</field><field name="arch" type="xml"><search string="搜索库存预留"><field name="name"/><field name="external_id"/><field name="client_id"/><field name="partner_id"/><filter name="active" string="有效" domain="[('state','=','active')]"/><filter name="expired" string="已过期" domain="[('state','=','expired')]"/><group><filter name="group_state" string="状态" context="{'group_by':'state'}"/><filter name="group_client" string="客户端" context="{'group_by':'client_id'}"/></group></search></field></record>

    <record id="view_shop_api_request_log_list" model="ir.ui.view"><field name="name">shop.api.request.log.list</field><field name="model">shop.api.request.log</field><field name="arch" type="xml"><list string="请求日志" create="0" edit="0" delete="0"><field name="create_date" string="请求时间"/><field name="request_id" string="请求编号"/><field name="client_id" string="客户端"/><field name="method" string="HTTP 方法"/><field name="path" string="路径"/><field name="response_status" string="HTTP 状态" decoration-success="response_status &gt;= 200 and response_status &lt; 400" decoration-danger="response_status &gt;= 400"/><field name="duration_ms" string="耗时（毫秒）"/><field name="state" string="状态" decoration-success="state == 'success'" decoration-danger="state == 'error'"/></list></field></record>
    <record id="view_shop_api_request_log_form" model="ir.ui.view"><field name="name">shop.api.request.log.form</field><field name="model">shop.api.request.log</field><field name="arch" type="xml"><form string="请求日志" create="0" edit="0" delete="0"><sheet><div class="oe_title"><label for="request_id"/><h1><field name="request_id"/></h1></div><group><group><field name="create_date" string="请求时间"/><field name="client_id"/><field name="endpoint_id"/><field name="method"/><field name="path"/><field name="source_ip"/></group><group><field name="state"/><field name="response_status"/><field name="duration_ms"/><field name="idempotency_key"/><field name="error_code"/><field name="error_message"/></group></group><notebook><page string="请求内容"><field name="request_body" readonly="1"/></page><page string="响应内容"><field name="response_body" readonly="1"/></page></notebook></sheet></form></field></record>
    <record id="view_shop_api_request_log_search" model="ir.ui.view"><field name="name">shop.api.request.log.search</field><field name="model">shop.api.request.log</field><field name="arch" type="xml"><search string="搜索请求日志"><field name="request_id"/><field name="client_id"/><field name="path"/><field name="error_code"/><filter name="errors" string="仅失败" domain="[('state','=','error')]"/><filter name="slow" string="慢请求（超过 1 秒）" domain="[('duration_ms','&gt;',1000)]"/><group><filter name="group_client" string="客户端" context="{'group_by':'client_id'}"/><filter name="group_state" string="状态" context="{'group_by':'state'}"/><filter name="group_day" string="日期" context="{'group_by':'create_date:day'}"/></group></search></field></record>

    <record id="view_shop_api_event_list" model="ir.ui.view"><field name="name">shop.api.event.list</field><field name="model">shop.api.event</field><field name="arch" type="xml"><list string="事件队列" create="0" delete="0"><field name="occurred_at" string="发生时间"/><field name="event_id" string="事件编号"/><field name="event_type_id" string="事件类型"/><field name="client_id" string="客户端" optional="show"/><field name="resource_model" string="资源模型" optional="hide"/><field name="resource_uuid" string="资源 UUID" optional="hide"/><field name="attempt_count" string="尝试次数"/><field name="next_attempt_at" string="下次尝试" optional="hide"/><field name="state" string="状态" decoration-success="state == 'delivered'" decoration-warning="state in ('pending','delivering','failed')" decoration-danger="state == 'dead'"/></list></field></record>
    <record id="view_shop_api_event_form" model="ir.ui.view"><field name="name">shop.api.event.form</field><field name="model">shop.api.event</field><field name="arch" type="xml"><form string="事件详情" create="0" delete="0"><header><button name="action_retry" type="object" string="重新加入投递队列" class="btn-primary" invisible="state not in ('failed','dead')" confirm="事件将重新投递到已订阅的外部商城。确定继续吗？"/><field name="state" widget="statusbar" statusbar_visible="pending,delivering,delivered,failed,dead"/></header><sheet><div class="oe_title"><label for="event_id"/><h1><field name="event_id" readonly="1"/></h1></div><group><group><field name="event_type_id" readonly="1"/><field name="client_id" readonly="1"/><field name="company_id" readonly="1" groups="base.group_multi_company"/><field name="occurred_at" readonly="1"/><field name="delivered_at" readonly="1"/></group><group><field name="resource_model" readonly="1"/><field name="resource_id" readonly="1"/><field name="resource_uuid" readonly="1"/><field name="resource_version" readonly="1"/><field name="attempt_count" readonly="1"/><field name="next_attempt_at" readonly="1"/></group></group><notebook><page string="事件数据"><field name="payload" readonly="1"/></page><page string="最近错误"><field name="last_error" readonly="1"/></page></notebook></sheet></form></field></record>
    <record id="view_shop_api_event_search" model="ir.ui.view"><field name="name">shop.api.event.search</field><field name="model">shop.api.event</field><field name="arch" type="xml"><search string="搜索事件"><field name="event_id"/><field name="event_type_id"/><field name="client_id"/><field name="resource_uuid"/><filter name="waiting" string="等待处理" domain="[('state','in',('pending','failed'))]"/><filter name="dead" string="已停止" domain="[('state','=','dead')]"/><group><filter name="group_state" string="状态" context="{'group_by':'state'}"/><filter name="group_type" string="事件类型" context="{'group_by':'event_type_id'}"/></group></search></field></record>

    <record id="view_shop_api_delivery_list" model="ir.ui.view"><field name="name">shop.api.webhook.delivery.list</field><field name="model">shop.api.webhook.delivery</field><field name="arch" type="xml"><list string="Webhook 投递记录" create="0" delete="0"><field name="create_date" string="创建时间"/><field name="event_id" string="事件"/><field name="webhook_id" string="Webhook"/><field name="attempt_count" string="尝试次数"/><field name="last_attempt_at" string="最后尝试"/><field name="response_status" string="HTTP 状态"/><field name="duration_ms" string="耗时（毫秒）"/><field name="state" string="状态" decoration-success="state == 'success'" decoration-danger="state == 'failed'"/></list></field></record>
    <record id="view_shop_api_delivery_form" model="ir.ui.view"><field name="name">shop.api.webhook.delivery.form</field><field name="model">shop.api.webhook.delivery</field><field name="arch" type="xml"><form string="Webhook 投递详情" create="0" delete="0"><header><button name="action_retry_delivery" type="object" string="立即重新投递" class="btn-primary" invisible="state != 'failed'" confirm="将立即向外部 Webhook 地址发送此事件。确定继续吗？"/><field name="state" widget="statusbar" statusbar_visible="pending,success,failed"/></header><sheet><group><group><field name="event_id" readonly="1"/><field name="webhook_id" readonly="1"/><field name="attempt_count" readonly="1"/><field name="last_attempt_at" readonly="1"/></group><group><field name="response_status" readonly="1"/><field name="duration_ms" readonly="1"/><field name="last_error" readonly="1"/></group></group><field name="response_body" string="响应正文" readonly="1"/></sheet></form></field></record>

    <record id="view_shop_api_idempotency_list" model="ir.ui.view"><field name="name">shop.api.idempotency.list</field><field name="model">shop.api.idempotency</field><field name="arch" type="xml"><list string="幂等记录" create="0" edit="0"><field name="create_date" string="创建时间"/><field name="client_id" string="客户端"/><field name="key" string="幂等键"/><field name="method" string="HTTP 方法"/><field name="path" string="路径"/><field name="response_status" string="HTTP 状态"/><field name="expires_at" string="失效时间"/><field name="state" string="状态"/></list></field></record>
    <record id="view_shop_api_idempotency_form" model="ir.ui.view"><field name="name">shop.api.idempotency.form</field><field name="model">shop.api.idempotency</field><field name="arch" type="xml"><form string="幂等记录" create="0" edit="0"><sheet><group><group><field name="client_id"/><field name="key"/><field name="method"/><field name="path"/></group><group><field name="state"/><field name="response_status"/><field name="expires_at"/><field name="request_hash"/></group></group><field name="response_body" string="缓存响应"/></sheet></form></field></record>

    <record id="view_shop_api_checkpoint_list" model="ir.ui.view"><field name="name">shop.api.sync.checkpoint.list</field><field name="model">shop.api.sync.checkpoint</field><field name="arch" type="xml"><list string="同步检查点" multi_edit="1"><field name="client_id"/><field name="resource_type" string="资源类型"/><field name="cursor" string="游标"/><field name="last_event_id" string="最后事件编号"/><field name="synchronized_at" string="同步时间"/><field name="state" string="状态" decoration-success="state == 'idle'" decoration-warning="state == 'running'" decoration-danger="state == 'error'"/></list></field></record>
    <record id="view_shop_api_checkpoint_form" model="ir.ui.view"><field name="name">shop.api.sync.checkpoint.form</field><field name="model">shop.api.sync.checkpoint</field><field name="arch" type="xml"><form string="同步检查点"><sheet><group><group><field name="client_id"/><field name="resource_type"/><field name="state"/></group><group><field name="cursor"/><field name="last_event_id"/><field name="synchronized_at"/></group></group><field name="last_error" string="最近错误" readonly="1"/></sheet></form></field></record>

    <record id="view_shop_api_reconciliation_list" model="ir.ui.view"><field name="name">shop.api.reconciliation.list</field><field name="model">shop.api.reconciliation</field><field name="arch" type="xml"><list string="对账任务"><field name="name" string="任务编号"/><field name="client_id" string="客户端"/><field name="resource_type" string="资源类型"/><field name="requested_at" string="请求时间"/><field name="completed_at" string="完成时间"/><field name="checked_count" string="检查数量"/><field name="mismatch_count" string="差异数量" decoration-danger="mismatch_count &gt; 0"/><field name="state" string="状态" decoration-success="state == 'done'" decoration-danger="state == 'error'"/></list></field></record>
    <record id="view_shop_api_reconciliation_form" model="ir.ui.view"><field name="name">shop.api.reconciliation.form</field><field name="model">shop.api.reconciliation</field><field name="arch" type="xml"><form string="对账任务"><header><field name="state" widget="statusbar" statusbar_visible="pending,running,done,error"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div><group><group><field name="client_id"/><field name="resource_type"/><field name="requested_at" readonly="1"/><field name="completed_at" readonly="1"/></group><group><field name="checked_count" readonly="1"/><field name="mismatch_count" readonly="1"/><field name="last_error" readonly="1"/></group></group><field name="details" string="对账结果" readonly="1"/></sheet></form></field></record>

    <record id="view_shop_api_external_reference_list" model="ir.ui.view"><field name="name">shop.api.external.reference.list</field><field name="model">shop.api.external.reference</field><field name="arch" type="xml"><list string="外部编号映射"><field name="client_id"/><field name="resource_type" string="资源类型"/><field name="external_id" string="商城编号"/><field name="resource_model" string="Odoo 模型"/><field name="resource_id" string="Odoo 记录编号"/><field name="resource_uuid" string="资源 UUID"/></list></field></record>
    <record id="view_shop_api_external_reference_form" model="ir.ui.view"><field name="name">shop.api.external.reference.form</field><field name="model">shop.api.external.reference</field><field name="arch" type="xml"><form string="外部编号映射"><sheet><group><field name="client_id"/><field name="resource_type"/><field name="external_id"/><field name="resource_model"/><field name="resource_id"/><field name="resource_uuid"/></group></sheet></form></field></record>

    <record id="action_shop_api_reservations" model="ir.actions.act_window"><field name="name">库存预留</field><field name="res_model">shop.api.reservation</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_request_logs" model="ir.actions.act_window"><field name="name">请求日志</field><field name="res_model">shop.api.request.log</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_events" model="ir.actions.act_window"><field name="name">事件队列</field><field name="res_model">shop.api.event</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_deliveries" model="ir.actions.act_window"><field name="name">Webhook 投递</field><field name="res_model">shop.api.webhook.delivery</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_idempotency" model="ir.actions.act_window"><field name="name">幂等记录</field><field name="res_model">shop.api.idempotency</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_checkpoints" model="ir.actions.act_window"><field name="name">同步检查点</field><field name="res_model">shop.api.sync.checkpoint</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_reconciliations" model="ir.actions.act_window"><field name="name">对账任务</field><field name="res_model">shop.api.reconciliation</field><field name="view_mode">list,form</field></record>
    <record id="action_shop_api_external_references" model="ir.actions.act_window"><field name="name">外部编号映射</field><field name="res_model">shop.api.external.reference</field><field name="view_mode">list,form</field></record>
</odoo>
