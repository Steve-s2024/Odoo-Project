<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_dashboard_external_sales" model="spreadsheet.dashboard">
        <field name="name">外部销售</field>
        <field name="main_data_model_ids" eval="[(4, ref('sale.model_sale_order'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_sales"/>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="sequence">150</field>
        <field name="is_published">True</field>
    </record>

    <record id="action_external_sales_dashboard_report" model="ir.actions.client">
        <field name="name">外部销售报表</field>
        <field name="path">external-sales-report</field>
        <field name="tag">action_spreadsheet_dashboard</field>
        <field name="params" eval="{'dashboard_id': ref('spreadsheet_dashboard_external_sales')}"/>
    </record>

    <menuitem
        id="menu_external_sales_dashboard_report"
        name="外部销售报表"
        parent="sale.menu_sale_report"
        action="action_external_sales_dashboard_report"
        sequence="40"
        groups="sales_team.group_sale_manager"
    />

    <!--
        The spreadsheet payload is a curated, versioned dashboard snapshot.
        Do not regenerate it during an unrelated module upgrade: repeatedly
        transforming the live attachment can damage formulas and empty KPI
        cards.  Domain generation remains available as an explicit model
        method for controlled migrations only.
    -->
</odoo>
