<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sun_web_layout_branding" inherit_id="web.layout" name="SUN Web Layout Branding">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'SUN ERP'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/png" rel="shortcut icon" sizes="512x512" href="/stock_subwarehouse_hierarchy/static/img/favicon.png"/>
        </xpath>
    </template>

    <template id="sun_brand_promotion_message" inherit_id="web.brand_promotion_message" name="SUN Brand Promotion">
        <xpath expr="//a[hasclass('badge')]" position="replace">
            <span class="badge text-bg-light">
                <img alt="SUN"
                    src="/stock_subwarehouse_hierarchy/static/img/logo.png"
                    width="62" height="20"
                    style="width: auto; height: 1em; vertical-align: baseline;"/>
            </span>
        </xpath>
    </template>

    <template id="sun_login_footer_branding" inherit_id="web.login_layout" name="SUN Login Footer Branding">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span>SUN ERP</span>
        </xpath>
    </template>

    <template id="sun_website_page_transitions" inherit_id="website.layout" name="SUN Website Page Transitions">
        <xpath expr="//t[@t-set='x_icon']" position="after">
            <t t-set="x_seo_object" t-value="seo_object or main_object"/>
            <t t-set="title" t-value="(x_seo_object and 'website_meta_title' in x_seo_object and x_seo_object.website_meta_title) or request.env['ir.http']._sun_format_website_title(title)"/>
            <t t-set="default_title" t-value="request.env['ir.http']._sun_format_website_title(default_title)"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <style>
                .o_lang_flag {
                    width: 1.5em;
                    height: 1em;
                    border-radius: 2px;
                    vertical-align: -0.075em;
                    box-shadow: none;
                }
                header#top .nav-link,
                header#top .btn {
                    font-family: Inter, "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
                    font-size: 15px !important;
                }
                header#top #top_menu .nav-link {
                    font-weight: 500;
                }
                header#top .js_language_selector .dropdown-toggle,
                header#top .o_no_autohide_item &gt; a,
                header#top a.btn-outline-primary {
                    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
                    font-size: 14px !important;
                }
                .s_cover:has(.x_scroll_hint) {
                    position: relative;
                }
                .x_scroll_hint {
                    position: absolute;
                    left: 50%;
                    bottom: 28px;
                    z-index: 2;
                    padding: 10px;
                    margin-left: -32px;
                    color: #fff !important;
                    line-height: 0;
                    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.35));
                    animation: x_scroll_hint_bob 2.4s ease-in-out infinite;
                }
                .s_text_image:has(.x_scroll_target) {
                    position: relative;
                }
                .x_scroll_target {
                    position: absolute;
                    top: 100px;
                }
                .x_feature .o_grid_item:not(.o_grid_item_image) {
                    align-self: center;
                }
                .x_feature h2 {
                    margin-bottom: 16px;
                }
                .x_feature p {
                    line-height: 1.6;
                }
                .x_feature p:has(.btn) {
                    margin: 8px 0 0;
                }
                .x_card {
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                }
                .x_card h2 {
                    margin-bottom: 16px;
                }
                .x_card p {
                    font-size: 17px;
                    line-height: 1.6;
                }
                .x_card .x_card_eyebrow {
                    margin-bottom: 4px;
                    font-size: 20px;
                }
                .x_card .x_card_link {
                    margin: 8px 0 0;
                    font-size: 20px;
                }
                @media (min-width: 992px) {
                    .row.o_grid_mode:has(&gt; .x_card) {
                        grid-auto-rows: minmax(50px, auto);
                    }
                    .row.o_grid_mode:has(&gt; .x_card) &gt; .o_grid_item_image {
                        position: relative;
                    }
                    .row.o_grid_mode:has(&gt; .x_card) &gt; .o_grid_item_image img {
                        position: absolute;
                        inset: 0;
                        width: 100%;
                        height: 100%;
                    }
                }
                @media (max-width: 991.98px) {
                    .x_card {
                        padding: 32px 24px !important;
                    }
                }
                @media (min-width: 992px) {
                    .x_feature .o_grid_item:not(.o_grid_item_image) {
                        padding-right: 40px !important;
                    }
                    .x_feature .o_grid_item[style*="grid-area: 1 / 6 / 13 / 12"] {
                        padding-right: 10px !important;
                        padding-left: 40px !important;
                    }
                    #one-touch-lock::before {
                        content: "";
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        height: 1730px;
                        background: url("/stock_subwarehouse_hierarchy/static/img/feature_lines.svg") no-repeat 0 0 / 100% 100%;
                        pointer-events: none;
                    }
                }
                @keyframes x_scroll_hint_bob {
                    0%, 100% { transform: translateY(0); }
                    50% { transform: translateY(6px); }
                }
                html.x_page_transition_ready body {
                    opacity: 1;
                    transition: opacity 320ms ease, transform 320ms ease;
                }
                html.x_page_transition_entering body {
                    opacity: 0;
                    transform: translateY(6px);
                }
                html.x_page_transition_leaving body {
                    opacity: 0;
                    transform: translateY(-4px);
                }
                @media (prefers-reduced-motion: reduce) {
                    html.x_page_transition_ready body,
                    html.x_page_transition_entering body,
                    html.x_page_transition_leaving body {
                        opacity: 1;
                        transform: none;
                        transition: none;
                    }
                    .x_scroll_hint {
                        animation: none;
                    }
                }
            </style>
        </xpath>
        <xpath expr="//body" position="inside">
            <script>
                (function () {
                    const root = document.documentElement;
                    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                        return;
                    }
                    root.classList.add("x_page_transition_entering");
                    const enter = () => {
                        root.classList.add("x_page_transition_ready");
                        requestAnimationFrame(() => root.classList.remove("x_page_transition_entering"));
                    };
                    if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", enter, { once: true });
                    } else {
                        enter();
                    }
                    document.addEventListener("click", (event) => {
                        const link = event.target.closest("a[href]");
                        if (!link || event.defaultPrevented || event.button !== 0) {
                            return;
                        }
                        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                            return;
                        }
                        if (link.target &amp;&amp; link.target !== "_self") {
                            return;
                        }
                        const url = new URL(link.href, window.location.href);
                        if (url.origin !== window.location.origin) {
                            return;
                        }
                        if (url.hash &amp;&amp; url.pathname === window.location.pathname) {
                            return;
                        }
                        root.classList.add("x_page_transition_leaving");
                    });
                    window.addEventListener("pageshow", () => {
                        root.classList.remove("x_page_transition_leaving");
                    });
                })();
            </script>
        </xpath>
    </template>

    <template id="sun_language_selector_flags" inherit_id="website.language_selector" name="SUN Language Selector Flags">
        <xpath expr="//t[@t-call='website.lang_flag'][@flag_image_url='active_lang.flag_image_url']" position="attributes">
            <attribute name="flag_image_url">'/stock_subwarehouse_hierarchy/static/img/flags/en_GB.svg' if active_lang.code == 'en_US' else ('/stock_subwarehouse_hierarchy/static/img/flags/zh_CN.svg' if active_lang.code == 'zh_CN' else active_lang.flag_image_url)</attribute>
        </xpath>
        <xpath expr="//t[@t-call='website.lang_flag'][@flag_image_url='lg.flag_image_url']" position="attributes">
            <attribute name="flag_image_url">'/stock_subwarehouse_hierarchy/static/img/flags/en_GB.svg' if lg.code == 'en_US' else ('/stock_subwarehouse_hierarchy/static/img/flags/zh_CN.svg' if lg.code == 'zh_CN' else lg.flag_image_url)</attribute>
        </xpath>
    </template>
</odoo>
