                            card.setAttribute("role", "status");
                            var logo = document.createElement("img");
                            logo.className = "x_page_loader_logo";
                            logo.alt = "";
                            logo.src = "/stock_subwarehouse_hierarchy/static/img/sun-your-sport-black.svg";
                            var track = document.createElement("span");
                            track.className = "x_page_loader_track";
                            var text = document.createElement("span");
                            text.className = "x_page_loader_label";
                            text.textContent = label;
                            card.appendChild(logo);
                            card.appendChild(track);
                            card.appendChild(text);
                            box.appendChild(card);
                            document.body.appendChild(box);
                        };
                        var hide = function () {
                            clearTimeout(showTimer);
                            clearTimeout(safety);
                            html.classList.remove("x_page_loading");
                        };
                        window.xPageLoader = {
                            show: function () {
                                if (!box) {
                                    build();
                                }
                                clearTimeout(showTimer);
                                clearTimeout(safety);
                                showTimer = setTimeout(function () {
                                    html.classList.add("x_page_loading");
                                }, 250);
                                safety = setTimeout(hide, 12000);
                            },
                            hide: hide,
                        };
                        // Hide again when the page comes back from the Back/Forward cache.
                        window.addEventListener("pageshow", function (event) {
                            if (event.persisted) {
                                hide();
                            }
                        });
                        // Prepare the (hidden) card after the page has loaded, so the logo is ready in time.
                        window.addEventListener("load", function () {
                            setTimeout(function () {
                                if (!box) {
                                    build();
                                }
                            }, 1500);
                        });
                    })();
                    // Dim the page while the next one loads; never leave it hidden.
                    const root = document.documentElement;
                    const reset = () => root.classList.remove("x_page_leaving");
                    window.addEventListener("pageshow", reset);
                    document.addEventListener("click", (event) => {
                        const link = event.target.closest("a[href]");
                        if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                            return;
                        }
                        const href = link.getAttribute("href");
                        if (href.startsWith("#") || link.hasAttribute("download") || link.dataset.bsToggle || (link.target &amp;&amp; link.target !== "_self")) {
                            return;
                        }
                        const url = new URL(link.href, window.location.href);
                        if (url.origin !== window.location.origin || (url.pathname === window.location.pathname &amp;&amp; url.search === window.location.search)) {
                            return;
                        }
                        setTimeout(() => {
                            if (!event.defaultPrevented) {
                                root.classList.add("x_page_leaving");
                                setTimeout(reset, 2500);
                                if (window.xPageLoader) {
                                    window.xPageLoader.show();
                                }
                            }
                        });
                    });
                })();
            </script>
        </xpath>
    </template>

