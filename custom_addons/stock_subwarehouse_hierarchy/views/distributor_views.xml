<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distributor_partner_list" model="ir.ui.view">
        <field name="name">res.partner.distributor.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Distributors" multi_edit="1" export_xlsx="0">
                <header>
                    <button name="action_open_distributor_import"
                            type="object"
                            string="Import Distributors"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="x_distributor_code"/>
                <field name="name"/>
                <field name="x_distributor_status" widget="badge"
                       decoration-success="x_distributor_status == 'active'"
                       decoration-warning="x_distributor_status in ['draft', 'review']"
                       decoration-danger="x_distributor_status in ['suspended', 'terminated']"/>
                <field name="x_distributor_level"/>
                <field name="x_distributor_territory"/>
                <field name="x_distributor_exclusive" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="property_product_pricelist" optional="show"/>
                <field name="x_distributor_agreement_end" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_distributor_partner_search" model="ir.ui.view">
        <field name="name">res.partner.distributor.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Distributors">
                <field name="name"/>
                <field name="x_distributor_code"/>
                <field name="x_distributor_territory"/>
                <field name="user_id"/>
                <filter name="active_distributors" string="Active"
                        domain="[('x_distributor_status', '=', 'active')]"/>
                <filter name="under_review" string="Under Review"
                        domain="[('x_distributor_status', '=', 'review')]"/>
                <filter name="suspended" string="Suspended"
                        domain="[('x_distributor_status', '=', 'suspended')]"/>
                <separator/>
                <filter name="exclusive" string="Exclusive Territory"
                        domain="[('x_distributor_exclusive', '=', True)]"/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'x_distributor_status'}"/>
                    <filter name="group_level" string="Level"
                            context="{'group_by': 'x_distributor_level'}"/>
                    <filter name="group_territory" string="Territory"
                            context="{'group_by': 'x_distributor_territory'}"/>
                    <filter name="group_salesperson" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_partner_form_distributor" model="ir.ui.view">
        <field name="name">res.partner.form.distributor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_is_distributor"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_distributor_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not x_is_distributor"
                        groups="sales_team.group_sale_salesman">
                    <field name="x_distributor_sale_order_count"
                           widget="statinfo" string="Sales Orders"/>
                </button>
                <button name="action_view_distributor_deliveries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not x_is_distributor"
                        groups="stock.group_stock_user">
                    <field name="x_distributor_delivery_count"
                           widget="statinfo" string="Deliveries"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page name="distributor_profile" string="Distributor"
                      invisible="not x_is_distributor">
                    <group>
                        <group string="Profile">
                            <field name="x_distributor_code"/>
                            <field name="x_distributor_status"/>
                            <field name="x_distributor_level"/>
                            <field name="x_distributor_territory"/>
                            <field name="x_distributor_exclusive"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Commercial Terms">
                            <field name="property_product_pricelist"/>
                            <field name="property_payment_term_id"/>
                            <field name="x_distributor_default_warehouse_id"/>
                            <field name="x_distributor_agreement_start"/>
                            <field name="x_distributor_agreement_end"/>
                            <field name="x_distributor_annual_target"/>
                            <field name="x_distributor_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Internal Notes">
                        <field name="x_distributor_notes" nolabel="1"
                               placeholder="Agreement scope, authorized products, compliance notes, and internal observations..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_distributors" model="ir.actions.act_window">
        <field name="name">Distributors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_distributor_partner_list"/>
        <field name="search_view_id" ref="view_distributor_partner_search"/>
        <field name="domain">[('x_is_distributor', '=', True), ('is_company', '=', True)]</field>
        <field name="context">{'partner_channel_import_type': 'distributor', 'default_x_is_distributor': True, 'default_is_company': True, 'default_company_type': 'company', 'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first distributor</p>
            <p>Store distributor agreements, territories, pricing, targets, sales orders, and deliveries in one place.</p>
        </field>
    </record>

    <record id="action_distributor_sale_orders" model="ir.actions.act_window">
        <field name="name">Distributor Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('partner_id.commercial_partner_id.x_is_distributor', '=', True)]</field>
    </record>

    <record id="action_distributor_deliveries" model="ir.actions.act_window">
        <field name="name">Distributor Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('partner_id.commercial_partner_id.x_is_distributor', '=', True)]</field>
    </record>
</odoo>
