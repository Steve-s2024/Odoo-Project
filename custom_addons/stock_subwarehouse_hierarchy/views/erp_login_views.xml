<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sun_erp_login_page" model="ir.ui.view">
        <field name="name">SUN ERP login presentation</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="web.login_layout"/>
        <field name="priority" eval="99"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <!--
                website.login_layout replaces the native login layout at priority 20.
                Apply after it so ERP can keep native authentication while removing the
                Website header and footer. Shops retain the unmodified Website branch.
            -->
            <xpath expr="//t[@t-call='website.layout']" position="replace">
                <t t-set="sun_erp_login_enabled"
                    t-value="request.db and request.env['ir.config_parameter'].sudo().get_param('sun.erp_login.enabled') == 'True'"/>

                <t t-if="sun_erp_login_enabled">
                    <t t-call="web.frontend_layout">
                        <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                        <t t-set="body_classname" t-value="'bg-100'"/>
                        <t t-set="no_header" t-value="True"/>
                        <t t-set="no_footer" t-value="True"/>
                        <t t-set="title">思安奇ERP系统登录</t>

                        <style>
                            .sun_erp_login_page {
                                min-height: 100vh;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                padding: 32px 16px;
                                font-family: Arial, "Microsoft YaHei", sans-serif;
                            }
                            .sun_erp_login_card {
                                width: 100%;
                                max-width: 420px;
                                border: 0;
                                border-radius: 16px;
                                background: #fff;
                                box-shadow: 0 18px 48px rgba(16, 24, 40, 0.12);
                            }
                            .sun_erp_login_card .card-body {
                                padding: 32px;
                            }
                            .sun_erp_login_brand {
                                padding: 4px 0 24px;
                                text-align: center;
                            }
                            .sun_erp_login_logo {
                                display: block;
                                width: auto;
                                height: 48px;
                                max-width: 150px;
                                margin: 0 auto 16px;
                                object-fit: contain;
                            }
                            .sun_erp_login_title {
                                margin: 0;
                                color: #111827;
                                font-family: Arial, "Microsoft YaHei", sans-serif;
                                font-size: 24px;
                                font-weight: 600;
                                line-height: 1.35;
                                letter-spacing: 0.02em;
                            }
                            @media (max-width: 575.98px) {
                                .sun_erp_login_card .card-body {
                                    padding: 26px 22px;
                                }
                            }
                        </style>

                        <main class="sun_erp_login_page">
                            <div class="card sun_erp_login_card">
                                <div class="card-body">
                                    <div class="sun_erp_login_brand">
                                        <img id="sun_erp_login_logo"
                                            class="sun_erp_login_logo"
                                            src="/stock_subwarehouse_hierarchy/static/img/logo.png"
                                            alt="SUN"/>
                                        <h1 class="sun_erp_login_title">思安奇ERP系统</h1>
                                    </div>
                                    <t t-out="0"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </t>

                <t t-else="">
                    <t t-call="website.layout">
                        <div class="oe_website_login_container" t-out="0"/>
                    </t>
                </t>
            </xpath>
        </field>
    </record>

    <!--
        Keep authentication entirely in Odoo's native web.login controller.
        This view only makes the ERP login presentation consistently Chinese,
        including when an old bookmark points to /en/web/login.  The flag is
        stored only on the ERP database, so storefront login pages keep their
        normal language-aware labels.
    -->
    <template id="sun_erp_login_form_chinese"
        inherit_id="web.login"
        name="SUN ERP login form in Chinese"
        priority="100">
        <xpath expr="//t[@t-call='web.login_layout']" position="before">
            <t t-set="sun_erp_login_enabled"
                t-value="request.db and request.env['ir.config_parameter'].sudo().get_param('sun.erp_login.enabled') == 'True'"/>
        </xpath>

        <xpath expr="//label[@for='db']" position="before">
            <label t-if="sun_erp_login_enabled" for="db" class="col-form-label">数据库</label>
        </xpath>
        <xpath expr="//label[@for='db' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>
        <xpath expr="//a[@href='/web/database/selector']" position="before">
            <a t-if="sun_erp_login_enabled" role="button" href="/web/database/selector"
                class="btn border border-start-0">
                选择 <i class="fa fa-database" role="img" aria-label="数据库" title="数据库"/>
            </a>
        </xpath>
        <xpath expr="//a[@href='/web/database/selector' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>

        <xpath expr="//label[@for='login']" position="before">
            <label t-if="sun_erp_login_enabled" for="login"
                class="form-label d-flex justify-content-between">账号或邮箱</label>
        </xpath>
        <xpath expr="//label[@for='login' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>
        <xpath expr="//input[@id='login']" position="before">
            <input t-if="sun_erp_login_enabled"
                type="text" placeholder="请输入账号或邮箱" name="login"
                t-att-value="login" id="login" class="form-control"
                required="required" autocapitalize="off" autocomplete="username"/>
        </xpath>
        <xpath expr="//input[@id='login' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>

        <xpath expr="//label[@for='password']" position="before">
            <label t-if="sun_erp_login_enabled" for="password" class="form-label">密码</label>
        </xpath>
        <xpath expr="//label[@for='password' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>
        <xpath expr="//input[@id='password']" position="before">
            <input t-if="sun_erp_login_enabled"
                type="password" placeholder="请输入密码" name="password"
                id="password" class="form-control" required="required"
                autocomplete="current-password"
                t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
        </xpath>
        <xpath expr="//input[@id='password' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>

        <xpath expr="//p[@t-if='error']/t[@t-esc='error']" position="replace">
            <t t-if="sun_erp_login_enabled and error == 'Wrong login/password'">错误的登录名/密码</t>
            <t t-elif="sun_erp_login_enabled and error == 'Only employees can access this database. Please contact the administrator.'">只有员工可以访问此数据库，请与管理员联系。</t>
            <t t-else="" t-esc="error"/>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit'][1]" position="before">
            <button t-if="sun_erp_login_enabled" type="submit" class="btn btn-primary">登录</button>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit' and not(@t-if)][1]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>
        <xpath expr="//button[@name='redirect' and @value='/web/become']" position="before">
            <button t-if="sun_erp_login_enabled" type="submit" name="redirect"
                value="/web/become" class="btn btn-link btn-sm">以超级用户身份登录</button>
        </xpath>
        <xpath expr="//button[@name='redirect' and @value='/web/become' and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>

        <xpath expr="//a[contains(@t-attf-href, '/web/reset_password')]" position="before">
            <a t-if="sun_erp_login_enabled and reset_password_enabled"
                class="btn btn-link btn-sm" tabindex="1"
                t-attf-href="/web/reset_password?{{ keep_query() }}">重置密码</a>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/web/reset_password') and @t-if='reset_password_enabled']" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled and reset_password_enabled</attribute>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/web/signup')]" position="before">
            <a t-if="sun_erp_login_enabled and signup_enabled"
                class="btn btn-link btn-sm mt-2"
                t-attf-href="/web/signup?{{ keep_query() }}">还没有账户？</a>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, '/web/signup') and @t-if='signup_enabled']" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled and signup_enabled</attribute>
        </xpath>
    </template>

    <template id="sun_erp_login_oauth_chinese"
        inherit_id="web.login_oauth"
        name="SUN ERP auxiliary login options in Chinese"
        priority="100">
        <xpath expr="//t[@t-set='auth_btns'][1]" position="before">
            <t t-set="sun_erp_login_enabled"
                t-value="request.db and request.env['ir.config_parameter'].sudo().get_param('sun.erp_login.enabled') == 'True'"/>
        </xpath>
        <xpath expr="//em[hasclass('text-muted')]" position="before">
            <em t-if="sun_erp_login_enabled"
                class="d-block my-3 small text-center text-muted">- 或 -</em>
        </xpath>
        <xpath expr="//em[hasclass('text-muted') and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled</attribute>
        </xpath>
        <xpath expr="//span[@t-out=&quot;p['body']&quot;]" position="before">
            <span t-if="sun_erp_login_enabled and p.get('list_item_class') == 'passkey_login_link'"
                class="mx-auto">使用通行密钥</span>
        </xpath>
        <xpath expr="//span[@t-out=&quot;p['body']&quot; and not(@t-if)]" position="attributes">
            <attribute name="t-if">not sun_erp_login_enabled or p.get('list_item_class') != 'passkey_login_link'</attribute>
        </xpath>
    </template>
</odoo>
