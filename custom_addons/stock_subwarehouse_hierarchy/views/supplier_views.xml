<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_partner_list" model="ir.ui.view">
        <field name="name">res.partner.supplier.channel.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Suppliers" multi_edit="1" export_xlsx="0">
                <header>
                    <button name="action_open_supplier_import"
                            type="object"
                            string="Import Suppliers"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="x_supplier_code"/>
                <field name="name"/>
                <field name="x_supplier_status" widget="badge"
                       decoration-success="x_supplier_status == 'active'"
                       decoration-info="x_supplier_status == 'approved'"
                       decoration-warning="x_supplier_status == 'prospective'"
                       decoration-danger="x_supplier_status == 'blocked'"
                       decoration-muted="x_supplier_status == 'inactive'"/>
                <field name="x_supplier_channel_type"/>
                <field name="x_supplier_preferred" optional="show"/>
                <field name="property_supplier_payment_term_id" optional="show"/>
                <field name="x_supplier_outstanding_bill_count"
                       groups="account.group_account_invoice" optional="show"/>
                <field name="x_supplier_debt_amount" widget="monetary"
                       groups="account.group_account_invoice" optional="show"/>
                <field name="x_supplier_company_currency_id" column_invisible="True"
                       groups="account.group_account_invoice"/>
                <field name="x_supplier_expected_receipt_count"
                       groups="stock.group_stock_user" optional="show"/>
                <field name="x_supplier_next_receipt_date"
                       groups="stock.group_stock_user" optional="show"/>
                <field name="x_supplier_default_warehouse_id"
                       groups="stock.group_stock_user" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_partner_search" model="ir.ui.view">
        <field name="name">res.partner.supplier.channel.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Suppliers">
                <field name="name"/>
                <field name="x_supplier_code"/>
                <field name="x_supplier_channel_type"/>
                <filter name="active_suppliers" string="Active"
                        domain="[('x_supplier_status', '=', 'active')]"/>
                <filter name="approved_suppliers" string="Approved"
                        domain="[('x_supplier_status', '=', 'approved')]"/>
                <filter name="preferred_suppliers" string="Preferred Supplier"
                        domain="[('x_supplier_preferred', '=', True)]"/>
                <filter name="blocked_suppliers" string="Blocked"
                        domain="[('x_supplier_status', '=', 'blocked')]"/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'x_supplier_status'}"/>
                    <filter name="group_channel" string="Supply Channel"
                            context="{'group_by': 'x_supplier_channel_type'}"/>
                    <filter name="group_country" string="Country"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_partner_form_supplier_channel" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.channel</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="supplier_rank" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_supplier_outstanding_bills"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="supplier_rank == 0"
                        groups="account.group_account_invoice">
                    <field name="x_supplier_outstanding_bill_count"
                           widget="statinfo" string="Outstanding Bills"/>
                </button>
                <button name="action_view_supplier_expected_receipts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="supplier_rank == 0"
                        groups="stock.group_stock_user">
                    <field name="x_supplier_expected_receipt_count"
                           widget="statinfo" string="Expected Receipts"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page name="supplier_channel" string="Supplier"
                      invisible="supplier_rank == 0">
                    <group>
                        <group string="Supply Profile">
                            <field name="x_supplier_code"/>
                            <field name="x_supplier_status"/>
                            <field name="x_supplier_channel_type"/>
                            <field name="x_supplier_preferred"/>
                            <field name="x_supplier_lead_days"/>
                            <field name="x_supplier_default_warehouse_id"
                                   groups="stock.group_stock_user"/>
                        </group>
                        <group string="Accounts Payable"
                               groups="account.group_account_invoice">
                            <field name="property_supplier_payment_term_id"/>
                            <field name="x_supplier_outstanding_bill_count" readonly="1"/>
                            <field name="x_supplier_debt_amount" readonly="1"/>
                            <field name="x_supplier_company_currency_id" invisible="1"/>
                        </group>
                        <group string="Incoming Goods"
                               groups="stock.group_stock_user">
                            <field name="x_supplier_expected_receipt_count" readonly="1"/>
                            <field name="x_supplier_next_receipt_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Internal Notes">
                        <field name="x_supplier_notes" nolabel="1"
                               placeholder="Authorized materials, quality requirements, settlement notes, and procurement observations..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_suppliers" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_supplier_partner_list"/>
        <field name="search_view_id" ref="view_supplier_partner_search"/>
        <field name="domain">[('supplier_rank', '&gt;', 0), ('is_company', '=', True)]</field>
        <field name="context">{'partner_channel_import_type': 'supplier', 'default_supplier_rank': 1, 'default_is_company': True, 'default_company_type': 'company'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first supplier</p>
            <p>Manage supply channels, unpaid bills, amounts payable, and expected receipts in one place.</p>
        </field>
    </record>

    <record id="action_supplier_outstanding_bills" model="ir.actions.act_window">
        <field name="name">Outstanding Supplier Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="domain">[('partner_id.commercial_partner_id.supplier_rank', '&gt;', 0), ('move_type', 'in', ['in_invoice', 'in_refund']), ('state', '=', 'posted'), ('amount_residual', '!=', 0)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True}</field>
    </record>

    <record id="action_supplier_expected_receipts" model="ir.actions.act_window">
        <field name="name">Expected Supplier Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('partner_id.commercial_partner_id.supplier_rank', '&gt;', 0), ('picking_type_id.code', '=', 'incoming'), ('state', 'not in', ['done', 'cancel'])]</field>
    </record>
</odoo>
