<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product detail pages should focus on the selected product. -->
    <record id="website_sale.product_search" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Enable Odoo's standard rating and customer discussion thread. -->
    <record id="website_sale.product_comment" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

    <!-- Disable wishlist entry points across product pages, cards, and headers. -->
    <record id="website_sale_wishlist.product_add_to_wishlist" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="website_sale_wishlist.add_to_wishlist" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_mobile" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_default" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_hamburger" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_stretch" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_vertical" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_search" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_sales_one" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_sales_two" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_sales_three" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_sales_four" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_sidebar" model="ir.ui.view"><field name="active" eval="False"/></record>
    <record id="website_sale_wishlist.template_header_boxed" model="ir.ui.view"><field name="active" eval="False"/></record>

    <template
        id="product_page_engagement_style"
        inherit_id="website_sale.product"
        name="Product engagement styling"
        priority="35"
    >
        <xpath expr="//section[@id='product_detail']" position="inside">
            <style>
                .o_wsale_product_page .o_wsale_products_searchbar_form,
                .o_wsale_product_page .o_wsale_product_search_mobile_btn {
                    display: none !important;
                }
                #o_product_page_reviews {
                    border-top: 1px solid #dedede;
                }
                #o_product_page_reviews .o_product_page_reviews_title h2 {
                    font-weight: 900;
                    letter-spacing: 0;
                }
            </style>
        </xpath>
    </template>
</odoo>
