<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="remote_portal_style" name="Remote portal shared style">
        <style>
            .x_purchase_page { background: #fff; color: #111; min-height: 68vh; }
            .x_purchase_inner { box-sizing: border-box; width: 100%; margin: 0; padding-left: clamp(24px, 6vw, 96px); padding-right: clamp(24px, 6vw, 96px); }
            .x_purchase_header { padding: 68px 0 30px; border-bottom: 1px solid #dedede; }
            .x_purchase_header h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 900; }
            .x_purchase_header p { margin: 12px 0 0; color: #666; }
            .x_purchase_list { padding-top: 24px; padding-bottom: 72px; }
            .x_purchase_item { display: grid; grid-template-columns: 1.2fr .9fr .8fr auto; gap: 18px; align-items: center; padding: 22px 0; border-bottom: 1px solid #e5e5e5; color: inherit; text-decoration: none; }
            .x_purchase_item:hover { background: #f7f7f7; margin: 0 -16px; padding-left: 16px; padding-right: 16px; }
            .x_portal_title_motion { position: relative; color: inherit; text-decoration: none; transition: color 180ms ease, transform 180ms ease; }
            .x_portal_title_motion::after { content: ""; position: absolute; right: 0; bottom: -0.14em; left: 0; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: right center; transition: transform 220ms ease; }
            .x_portal_title_motion:hover, .x_portal_title_motion:focus-visible { color: inherit; text-decoration: none; transform: translateY(-1px); }
            .x_portal_title_motion:hover::after, .x_portal_title_motion:focus-visible::after { transform: scaleX(1); transform-origin: left center; }
            .x_portal_title_motion:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
            .x_purchase_number { font-weight: 900; font-size: 1.08rem; }
            .x_purchase_meta { color: #666; font-size: .92rem; margin-top: 5px; }
            .x_purchase_status { display: inline-block; padding: 5px 9px; background: #f0f0f0; font-size: .82rem; font-weight: 800; }
            .x_payment_countdown { display: block; margin-top: 7px; color: #8a5a00; font-size: .82rem; font-weight: 700; }
            .x_payment_countdown_alert { margin: 18px 0 0; padding: 12px 16px; background: #fff5d6; color: #624500; }
            .x_payment_countdown.is-expired, .x_payment_countdown_alert.is-expired { background: #ffe5e5; color: #941b1b; }
            .x_purchase_amount { font-weight: 900; text-align: right; }
            .x_purchase_arrow { font-size: 1.35rem; }
            .x_purchase_empty { padding: 52px 0; color: #666; text-align: center; }
            .x_purchase_detail { padding-top: 52px; padding-bottom: 76px; }
            .x_purchase_back { color: #555; text-decoration: none; font-weight: 800; }
            .x_purchase_detail_head { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin: 28px 0 30px; padding-bottom: 24px; border-bottom: 2px solid #111; }
            .x_purchase_detail_head h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; }
            .x_purchase_grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, .7fr); gap: 36px; }
            .x_purchase_lines { border-top: 1px solid #dedede; }
            .x_purchase_line { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 20px; padding: 18px 0; border-bottom: 1px solid #dedede; align-items: center; }
            .x_purchase_line_name { font-weight: 800; }
            .x_product_name_with_options { min-width: 0; }
            .x_product_option_subtitle { margin-left: .65rem; color: #6b6b6b; font-size: .84rem; font-weight: 400; white-space: normal; }
            .x_purchase_line_qty { color: #666; white-space: nowrap; }
            .x_purchase_line_total { font-weight: 900; white-space: nowrap; text-align: right; }
            .x_purchase_summary { border: 1px solid #dedede; padding: 22px; align-self: start; }
            .x_purchase_summary dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 14px; }
            .x_purchase_summary dt { color: #666; font-weight: 600; }
            .x_purchase_summary dd { margin: 0; text-align: right; font-weight: 800; }
            .x_purchase_total { border-top: 1px solid #dedede; margin-top: 18px; padding-top: 18px; font-size: 1.15rem; }
            .x_purchase_receipt { margin-top: 20px; width: 100%; }
            .x_refund_form { padding-top: 52px; padding-bottom: 76px; max-width: none; }
            .x_refund_form h1 { margin: 24px 0 8px; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; }
            .x_refund_form p { color: #666; }
            .x_refund_table { margin-top: 28px; border-top: 2px solid #111; }
            .x_refund_row { display: grid; grid-template-columns: minmax(0, 1fr) 110px 120px; gap: 18px; padding: 18px 0; border-bottom: 1px solid #dedede; align-items: center; }
            .x_refund_row input { width: 100%; padding: 9px; border: 1px solid #aaa; }
            .x_refund_submit { margin-top: 26px; min-height: 46px; padding: 0 22px; font-weight: 900; }
            .x_refund_submit[disabled] { cursor: wait; opacity: .72; }
            .x_refund_submit_spinner { display: none; width: 1rem; height: 1rem; margin-right: .55rem; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; vertical-align: -.15rem; animation: x-refund-spin .75s linear infinite; }
            .x_refund_form.is-submitting .x_refund_submit_spinner { display: inline-block; }
            .x_refund_form.is-submitting .x_refund_submit_idle { display: none; }
            .x_refund_submit_loading { display: none; }
            .x_refund_form.is-submitting .x_refund_submit_loading { display: inline; }
            .x_refund_flash { position: fixed; z-index: 1095; top: 24px; left: 50%; width: min(92vw, 520px); transform: translateX(-50%); padding: 16px 22px; border: 1px solid transparent; box-shadow: 0 14px 42px rgba(0, 0, 0, .2); color: #fff; font-weight: 800; text-align: center; opacity: 1; transition: opacity .5s ease, transform .5s ease; }
            .x_refund_flash_success { background: #18794e; border-color: #0f6840; }
            .x_refund_flash_failure { background: #b42318; border-color: #8f1c13; }
            .x_refund_flash.is-leaving { opacity: 0; transform: translate(-50%, -12px); }
            @keyframes x-refund-spin { to { transform: rotate(360deg); } }
            .x_refund_history_list { border-top: 2px solid #111; }
            .x_refund_history_entry { padding: 20px 0; border-bottom: 1px solid #dedede; }
            .x_refund_history_head, .x_refund_history_item { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 20px; align-items: center; }
            .x_refund_history_status { color: #555; font-weight: 800; }
            .x_refund_history_total, .x_refund_history_amount { font-weight: 900; text-align: right; white-space: nowrap; }
            .x_refund_history_items { margin-top: 14px; padding: 12px 16px; background: #f7f7f7; }
            .x_refund_history_item { padding: 8px 0; }
            .x_refund_history_item + .x_refund_history_item { border-top: 1px solid #dedede; }
            .x_refund_return { margin-top: 12px; padding: 12px 16px; border-left: 3px solid #111; background: #fff8df; color: #4a3b00; }
            .x_remote_error { padding: 14px 18px; background: #ffe6e6; color: #8a1111; }
            @media (prefers-reduced-motion: reduce) { .x_portal_title_motion, .x_portal_title_motion::after { transition: none; } .x_portal_title_motion:hover, .x_portal_title_motion:focus-visible { transform: none; } }
            @media (max-width: 760px) { .x_purchase_grid, .x_purchase_detail_head { display: block; } .x_purchase_summary { margin-top: 28px; } }
            @media (max-width: 680px) { .x_purchase_inner { padding-left: 16px; padding-right: 16px; } .x_purchase_item { grid-template-columns: 1fr auto; } .x_refund_row { grid-template-columns: minmax(0,1fr) 90px; } .x_product_option_subtitle { display: block; margin: 4px 0 0; } }
        </style>
    </template>

    <template id="remote_product_option_subtitle" name="Remote Product Option Subtitle">
        <small t-if="item.get('selected_options')" class="x_product_option_subtitle">
            <t t-foreach="item.get('selected_options')" t-as="option">
                <t t-if="option_index"> · </t><span><t t-out="option.get('label')"/>: <t t-out="option.get('value')"/></span>
            </t>
        </small>
    </template>

    <template id="remote_purchase_history_page" name="Remote Purchase History">
        <t t-call="website.layout"><main id="wrap" class="x_purchase_page"><t t-call="storefront_api_bridge.remote_portal_style"/>
            <section class="x_purchase_header"><div class="x_purchase_inner"><h1 t-out="'Purchase History' if is_english else '购买记录'"/><p t-out="'Review payment, processing, and completed orders.' if is_english else '查看待支付、处理中和已完成的订单。'"/></div></section>
            <section class="x_purchase_inner x_purchase_list"><div id="oe_structure_purchase_history_top" class="oe_structure oe_empty"/>
                <p t-if="portal_error" class="x_remote_error" t-out="portal_error"/>
                <a t-foreach="orders" t-as="order" t-attf-href="/purchase-detail/#{order['id']}" class="x_purchase_item x_portal_title_motion">
                    <div><div class="x_purchase_number" t-out="order.get('number')"/><div class="x_purchase_meta" t-out="order.get('created_at')"/></div>
                    <div t-att-data-storefront-payment-expiry="order.get('payment_expires_at_epoch') or 0"
                         t-att-data-expired-label="'Expired' if is_english else '已过期'">
                        <span class="x_purchase_status" t-out="status_label(order, is_english)"/>
                        <small t-if="order.get('payment_state') in ('unpaid', 'pending', 'error') and not order.get('payment_expired')"
                               class="x_payment_countdown">
                            <t t-out="'Payment expires in ' if is_english else '支付剩余时间：'"/><span data-payment-countdown-value="1"/>
                        </small>
                    </div>
                    <span class="x_purchase_amount"><t t-out="currency_symbol(order.get('currency'))"/><t t-out="'{:,.2f}'.format(order.get('amount_total') or 0)"/></span><span class="x_purchase_arrow">&#8594;</span>
                </a>
                <p t-if="not orders and not portal_error" class="x_purchase_empty" t-out="'There are no purchases yet.' if is_english else '暂无购买记录。'"/>
                <div id="oe_structure_purchase_history_bottom" class="oe_structure oe_empty"/>
            </section>
        </main></t>
    </template>

    <template id="remote_refund_history" name="Remote Refund History">
        <section class="x_refund_history mt-5" t-if="refunds"><h2 class="h4 mb-3" t-out="'Refund history' if is_english else '退款记录'"/><div class="x_refund_history_list">
            <article t-foreach="refunds" t-as="refund" class="x_refund_history_entry">
                <div class="x_refund_history_head"><strong t-out="'Refund request' if is_english else '退款申请'"/><span class="x_refund_history_status"><t t-out="refund_label(refund, is_english)"/><t t-if="refund.get('return_delivery_state')"> · <t t-out="return_delivery_label(refund, is_english)"/></t></span><span class="x_refund_history_total"><t t-out="currency_symbol(refund.get('currency'))"/><t t-out="'{:,.2f}'.format(refund.get('amount') or 0)"/></span></div>
                <div class="x_refund_history_items"><div t-foreach="refund.get('items') or []" t-as="item" class="x_refund_history_item"><div class="x_product_name_with_options"><strong t-out="item.get('name')"/><t t-call="storefront_api_bridge.remote_product_option_subtitle"/></div><span><t t-out="'Quantity: ' if is_english else '数量：'"/><t t-out="item.get('quantity')"/></span><span class="x_refund_history_amount"><t t-out="currency_symbol(refund.get('currency'))"/><t t-out="'{:,.2f}'.format(item.get('amount') or 0)"/></span></div></div>
            </article></div>
        </section>
    </template>

    <template id="remote_purchase_detail_page" name="Remote Purchase Detail">
        <t t-call="website.layout"><main id="wrap" class="x_purchase_page"><t t-call="storefront_api_bridge.remote_portal_style"/>
            <div id="oe_structure_remote_purchase_detail_page_top" class="oe_structure oe_empty"/>
            <section class="x_purchase_inner x_purchase_detail"><div id="oe_structure_purchase_detail_top" class="oe_structure oe_empty"/><a href="/purchase-history" class="x_purchase_back x_portal_title_motion" t-out="'← Purchase History' if is_english else '← 购买记录'"/>
                <div t-if="resume_payment_error" class="x_remote_error mt-3" role="alert"
                     t-out="'This pending payment cannot be restored on the Shop. Please contact customer support.' if is_english else '此待支付订单暂时无法恢复，请联系客服。'"/>
                <div t-if="order.get('payment_state') in ('unpaid', 'pending', 'error') and not order.get('payment_expired')"
                     class="x_payment_countdown_alert"
                     t-att-data-storefront-payment-expiry="order.get('payment_expires_at_epoch') or 0"
                     t-att-data-expired-label="'Order expired' if is_english else '订单已过期'">
                    <t t-out="'Reserved inventory expires in ' if is_english else '库存保留剩余时间：'"/><strong data-payment-countdown-value="1"/>
                </div>
                <div class="x_purchase_detail_head"><div><p class="text-muted mb-2" t-out="'Order' if is_english else '订单'"/><h1 t-out="order.get('number')"/></div><span class="x_purchase_status" t-out="status"/></div>
                <div class="x_purchase_grid"><section><h2 class="h4 mb-3" t-out="'Items' if is_english else '商品明细'"/>
                    <div class="x_purchase_lines"><div t-foreach="order.get('items') or []" t-as="item" class="x_purchase_line"><div class="x_product_name_with_options"><span class="x_purchase_line_name" t-out="item.get('name')"/><t t-call="storefront_api_bridge.remote_product_option_subtitle"/></div><span class="x_purchase_line_qty">× <t t-out="item.get('quantity')"/></span><span class="x_purchase_line_total"><t t-out="currency_symbol(order.get('currency'))"/><t t-out="'{:,.2f}'.format(item.get('total') or 0)"/></span></div></div>
                </section><aside class="x_purchase_summary"><dl><dt t-out="'Order date' if is_english else '下单时间'"/><dd t-out="order.get('created_at')"/><dt t-out="'Payment status' if is_english else '支付状态'"/><dd t-out="payment_status"/><t t-if="order.get('payment_state') == 'paid'"><dt t-out="'Delivery status' if is_english else '配送状态'"/><dd t-out="delivery_status"/></t><dt t-out="'Payment method' if is_english else '支付方式'"/><dd t-out="payment_method"/><t t-if="payment and payment.get('provider_reference')"><dt t-out="'Transaction reference' if is_english else '交易参考号'"/><dd t-out="payment.get('provider_reference')"/></t></dl><dl class="x_purchase_total"><dt t-out="'Total' if is_english else '订单总额'"/><dd><t t-out="currency_symbol(order.get('currency'))"/><t t-out="'{:,.2f}'.format(order.get('amount_total') or 0)"/></dd></dl>
                    <a t-if="documents.get('receipt')" t-attf-href="/purchase-document/#{order['id']}/receipt.pdf" class="btn btn-outline-dark x_purchase_receipt" target="_blank" t-out="'Download receipt' if is_english else '下载付款收据'"/>
                    <a t-foreach="documents.get('invoices') or []" t-as="invoice" t-attf-href="/purchase-document/#{order['id']}/invoice/#{invoice['id']}.pdf" class="btn btn-outline-dark x_purchase_receipt" target="_blank"><t t-out="'Download invoice' if is_english else '下载发票'"/><t t-if="invoice.get('number')"> · <t t-out="invoice.get('number')"/></t></a>
                    <form t-if="can_pay" t-attf-action="/purchase-detail/#{order['id']}/pay" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-dark x_purchase_receipt"
                                t-out="'Pay order' if is_english else '支付订单'"/>
                    </form>
                    <a t-attf-href="/refund-item/#{order['id']}" class="btn btn-outline-dark x_purchase_receipt" t-out="'Request a refund' if is_english else '申请退款'"/>
                </aside></div><t t-call="storefront_api_bridge.remote_refund_history"/>
                <div id="oe_structure_purchase_detail_bottom" class="oe_structure oe_empty"/>
            </section>
        </main></t>
    </template>

    <template id="remote_refund_item_page" name="Remote Refund Item">
        <t t-call="website.layout"><main id="wrap" class="x_purchase_page"><t t-call="storefront_api_bridge.remote_portal_style"/>
            <div t-if="refund_flash" t-attf-class="x_refund_flash x_refund_flash_#{refund_flash}" data-refund-flash="1" role="status" aria-live="polite">
                <t t-if="refund_flash == 'success'" t-out="'Refund request submitted successfully.' if is_english else '退款申请提交成功。'"/>
                <t t-else="" t-out="'Refund request was not successful. Please contact customer support.' if is_english else '退款申请提交失败，请联系客服。'"/>
            </div>
            <div id="oe_structure_remote_refund_item_page_top" class="oe_structure oe_empty"/>
            <section class="x_purchase_inner x_refund_form"><div id="oe_structure_refund_item_top" class="oe_structure oe_empty"/><a t-attf-href="/purchase-detail/#{order['id']}" class="x_purchase_back x_portal_title_motion" t-out="'← Purchase details' if is_english else '← 购买详情'"/><h1 t-out="'Request a refund' if is_english else '申请退款'"/>
                <p t-out="'Select the purchased items and quantities you want reviewed for refund.' if is_english else '选择需要申请退款的商品与数量。审核通过后处理退款。'"/>
                <form t-attf-action="/refund-item/#{order['id']}/submit" method="post" data-refund-submit-form="1"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="refund_attempt_id" t-att-value="refund_attempt_id"/>
                    <div class="x_refund_table"><div t-foreach="order.get('items') or []" t-as="item" t-if="item.get('refundable')" class="x_refund_row"><div class="x_product_name_with_options"><strong t-out="item.get('name')"/><t t-call="storefront_api_bridge.remote_product_option_subtitle"/><small class="d-block text-muted"><t t-out="'Purchased quantity: ' if is_english else '购买数量：'"/><t t-out="item.get('quantity')"/></small></div><span><t t-out="currency_symbol(order.get('currency'))"/><t t-out="'{:,.2f}'.format(item.get('unit_price') or 0)"/></span><input type="number" min="0" t-att-max="item.get('quantity')" step="1" value="0" t-att-name="'quantity_' + item.get('product_id')"/></div></div>
                    <button type="submit" class="btn btn-dark x_refund_submit"><span class="x_refund_submit_spinner" aria-hidden="true"/><span class="x_refund_submit_idle" t-out="'Submit refund request' if is_english else '提交退款申请'"/><span class="x_refund_submit_loading" t-out="'Waiting for ERP confirmation…' if is_english else '正在等待 ERP 确认…'"/></button>
                </form><t t-call="storefront_api_bridge.remote_refund_history"/>
                <div id="oe_structure_refund_item_bottom" class="oe_structure oe_empty"/>
            </section>
        </main></t>
    </template>
</odoo>
