<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Upgrade-only tombstones for the retired authentication customizations.
        These records stay inactive so Odoo's native views render unchanged.
    -->
    <record id="storefront_localized_login_fields" model="ir.ui.view">
        <field name="name">Retired storefront login fields</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml"><t/></field>
        <field name="active" eval="False"/>
    </record>
    <template id="storefront_erp_confirmed_signup" inherit_id="auth_signup.signup" active="True" name="ERP-confirmed storefront signup">
        <xpath expr="//form[hasclass('oe_signup_form')]/input[@name='csrf_token']" position="after">
            <input type="hidden" name="signup_attempt_id" t-att-value="signup_attempt_id"/>
        </xpath>
        <xpath expr="//form[hasclass('oe_signup_form')]" position="attributes">
            <attribute name="data-storefront-erp-signup">1</attribute>
        </xpath>
        <xpath expr="//input[@id='name']" position="attributes">
            <attribute name="t-att-placeholder">'请输入姓名' if request.env.lang == 'zh_CN' else 'John Doe'</attribute>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="t-att-placeholder">'请输入电子邮箱' if request.env.lang == 'zh_CN' else 'name@example.com'</attribute>
        </xpath>
    </template>
    <template id="storefront_localized_signup_password_fields" inherit_id="auth_signup.fields" active="True" priority="80" name="Localized storefront signup password placeholders">
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="t-att-placeholder">'请输入密码' if request.env.lang == 'zh_CN' else '••••••••••'</attribute>
        </xpath>
        <xpath expr="//input[@id='confirm_password']" position="attributes">
            <attribute name="t-att-placeholder">'请再次输入密码' if request.env.lang == 'zh_CN' else '••••••••••'</attribute>
        </xpath>
    </template>
    <template id="storefront_erp_confirmed_password_reset" inherit_id="auth_signup.reset_password" active="True" name="ERP-confirmed storefront password reset">
        <xpath expr="//form[hasclass('oe_reset_password_form')]/input[@name='csrf_token']" position="after">
            <input t-if="not token" type="hidden" name="password_reset_attempt_id" t-att-value="password_reset_attempt_id"/>
        </xpath>
        <xpath expr="//form[hasclass('oe_reset_password_form')]" position="attributes">
            <attribute name="data-storefront-erp-password-reset">1</attribute>
        </xpath>
    </template>
    <!-- These views were deliberately deactivated by the native-auth rollback.
         Re-enable the existing records explicitly during module upgrades. -->
    <record id="storefront_erp_confirmed_signup" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>
    <record id="storefront_localized_signup_password_fields" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>
    <record id="storefront_erp_confirmed_password_reset" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>
</odoo>
