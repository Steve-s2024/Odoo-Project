<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_contact_order" model="ir.ui.view">
        <field name="name">website.form.contact.order</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Contact to order" name="page_contact_order">
                    <group>
                        <field name="x_contact_to_order"/>
                        <field name="x_contact_order_phone"/>
                        <field name="x_contact_order_email"/>
                        <field name="x_contact_order_wechat"/>
                        <field name="x_contact_order_wechat_english"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
