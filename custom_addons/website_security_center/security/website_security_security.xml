<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_website_security" model="ir.module.category">
        <field name="name">网站安全中心</field>
        <field name="sequence">36</field>
    </record>
    <record id="privilege_website_security" model="res.groups.privilege">
        <field name="name">网站安全中心</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="website_security_center.module_category_website_security"/>
    </record>
    <record id="group_website_security_viewer" model="res.groups">
        <field name="name">网站安全审计员</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="website_security_center.privilege_website_security"/>
        <field name="implied_ids" eval="[Command.link(ref('shop_api.group_shop_api_auditor'))]"/>
    </record>
    <record id="group_website_security_operator" model="res.groups">
        <field name="name">网站安全处置员</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="website_security_center.privilege_website_security"/>
        <field name="implied_ids" eval="[Command.link(ref('website_security_center.group_website_security_viewer'))]"/>
    </record>
    <record id="group_website_security_admin" model="res.groups">
        <field name="name">网站安全管理员</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="website_security_center.privilege_website_security"/>
        <field name="implied_ids" eval="[Command.link(ref('website_security_center.group_website_security_operator'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="rule_website_security_incident_company" model="ir.rule">
        <field name="name">网站安全事件公司隔离</field>
        <field name="model_id" ref="model_website_security_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('website_security_center.group_website_security_viewer'))]"/>
    </record>
    <record id="rule_website_security_policy_company" model="ir.rule">
        <field name="name">网站安全策略公司隔离</field>
        <field name="model_id" ref="model_website_security_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('website_security_center.group_website_security_viewer'))]"/>
    </record>
    <record id="rule_website_security_check_company" model="ir.rule">
        <field name="name">网站安全检查公司隔离</field>
        <field name="model_id" ref="model_website_security_health_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('website_security_center.group_website_security_viewer'))]"/>
    </record>
</odoo>
