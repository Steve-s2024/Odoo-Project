--- odoo-storefront
+++ odoo-storefront
@@ -1,6 +1,10 @@
 server {
     server_name sunwintersports.com www.sunwintersports.com;

+    include /etc/nginx/snippets/shop-security-headers.conf;
+    limit_req_status 429;
+    limit_conn shop_per_ip 50;
+
     client_max_body_size 1g;
     proxy_read_timeout 720s;
     proxy_connect_timeout 720s;
@@ -31,6 +35,7 @@
     location = /payment/lianlian/notify {
         if ($request_method != POST) { return 405; }

+        limit_req zone=shop_callback burst=60 nodelay;
         proxy_pass https://49.233.77.243;
         proxy_http_version 1.1;
         proxy_set_header Host 49.233.77.243;
@@ -50,6 +55,24 @@

     include /etc/nginx/snippets/shop-legacy-rpc-block.conf;

+    location ~ "^/(?:[a-z]{2}(?:_[A-Z]{2})?/)?web/login$" {
+        limit_req zone=shop_login burst=8 nodelay;
+        limit_conn shop_per_ip 10;
+        proxy_pass http://127.0.0.1:8070;
+    }
+
+    location ~ "^/(?:[a-z]{2}(?:_[A-Z]{2})?/)?shop/(?:checkout|payment)(?:/|$)" {
+        limit_req zone=shop_checkout burst=40 nodelay;
+        limit_conn shop_per_ip 20;
+        proxy_pass http://127.0.0.1:8070;
+    }
+
+    # Never serve repository metadata, environment files, or other dotfiles.
+    # ACME validation remains available for certificate renewal.
+    location ~ /\.(?!well-known(?:/|$)) {
+        deny all;
+    }
+
     location / {
         proxy_pass http://127.0.0.1:8070;
     }
